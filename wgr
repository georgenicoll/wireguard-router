#!/usr/bin/env bash
# Thin wrapper around tofu that selects a cloud stack and injects the external
# config file, so that day-to-day use is:
#
#   ./wgr linode init
#   ./wgr linode plan
#   ./wgr linode apply
#   ./wgr linode output
#   ./wgr linode destroy
#
# Switching cloud means changing one word:  ./wgr gcp apply
#
# Configuration:
#   WGR_CONFIG     path to your private, cloud-agnostic .tfvars file (required
#                  for plan/apply/destroy). Its directory must also contain a
#                  <platform>.tfvars file (e.g. linode.tfvars, gcp.tfvars) with
#                  that cloud's own settings - see *.example.tfvars.
#   WGR_KEYS       optional key store location, managed by scripts/wg-peer.sh.
#                  Defaults to <dir of WGR_CONFIG>/wireguard-router-keys. When
#                  it contains wireguard.generated.tfvars, that file is passed
#                  to tofu as well, supplying the WireGuard keys and peers.
#   WGR_STATE_DIR  optional directory to keep state in, instead of the stack
#                  directory. State contains your WireGuard private key and
#                  Dynu password, so a private, backed-up location is sensible.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat >&2 <<USAGE
Usage: ./wgr <platform> <tofu-command> [args...]

Platforms: $(cd "$REPO_DIR/stacks" && ls -d */ | tr -d '/' | tr '\n' ' ')

Examples:
  ./wgr linode init
  ./wgr linode plan
  ./wgr linode apply
  ./wgr linode output -raw wireguard_endpoint
  ./wgr linode destroy
USAGE
    exit 2
}

[[ $# -lt 2 ]] && usage

PLATFORM="$1"; shift
COMMAND="$1"; shift

STACK_DIR="$REPO_DIR/stacks/$PLATFORM"
if [[ ! -d "$STACK_DIR" ]]; then
    echo "error: unknown platform '$PLATFORM' (no stacks/$PLATFORM)" >&2
    usage
fi

command -v tofu >/dev/null 2>&1 || {
    echo "error: 'tofu' is not on PATH. See https://opentofu.org/docs/intro/install/" >&2
    exit 1
}

ARGS=()

# Commands that consume variables need the external config file.
case "$COMMAND" in
plan | apply | destroy | refresh | import | console)
    if [[ -z "${WGR_CONFIG:-}" ]]; then
        cat >&2 <<MSG
error: WGR_CONFIG is not set.

Point it at your private config file, for example:
  cp config.example.tfvars ~/private/wireguard-router.tfvars
  export WGR_CONFIG=~/private/wireguard-router.tfvars
MSG
        exit 1
    fi
    CONFIG_PATH="$(cd "$(dirname "$WGR_CONFIG")" && pwd)/$(basename "$WGR_CONFIG")"
    if [[ ! -r "$CONFIG_PATH" ]]; then
        echo "error: cannot read config file: $CONFIG_PATH" >&2
        exit 1
    fi
    # Absolute, because -chdir changes how relative paths resolve.
    ARGS+=("-var-file=$CONFIG_PATH")

    # Cloud-specific settings live in their own file next to the main config,
    # named after the platform (e.g. linode.tfvars, gcp.tfvars). Keeping them
    # out of the main config means switching cloud never risks a stray
    # variable from another platform's block breaking the plan.
    PLATFORM_CONFIG="$(dirname "$CONFIG_PATH")/$PLATFORM.tfvars"
    if [[ ! -r "$PLATFORM_CONFIG" ]]; then
        cat >&2 <<MSG
error: cannot read $PLATFORM_CONFIG

Each platform needs its own settings file next to your main config, for example:
  cp $PLATFORM.example.tfvars $(dirname "$CONFIG_PATH")/$PLATFORM.tfvars
MSG
        exit 1
    fi
    ARGS+=("-var-file=$PLATFORM_CONFIG")

    # The key store's generated tfvars supplies wireguard_private_key and
    # wireguard_peers. It is passed *after* the main config so that its values
    # win, and it is optional: without it you can still set those by hand.
    STORE="${WGR_KEYS:-$(dirname "$CONFIG_PATH")/wireguard-router-keys}"
    GENERATED="$STORE/wireguard.generated.tfvars"
    if [[ -r "$GENERATED" ]]; then
        ARGS+=("-var-file=$GENERATED")
        # Values in the main config would be silently overridden, which is
        # confusing enough to be worth calling out.
        if grep -qE '^[[:space:]]*(wireguard_private_key|wireguard_peers)[[:space:]]*=' "$CONFIG_PATH"; then
            echo "warning: $(basename "$CONFIG_PATH") sets wireguard_private_key or" >&2
            echo "         wireguard_peers, but the generated key store file takes" >&2
            echo "         precedence. Remove them from your config to avoid confusion." >&2
        fi
    fi
    ;;
esac

# Optional external state location, one state file per platform.
if [[ -n "${WGR_STATE_DIR:-}" ]]; then
    mkdir -p "$WGR_STATE_DIR"
    STATE_DIR_ABS="$(cd "$WGR_STATE_DIR" && pwd)"
    case "$COMMAND" in
    plan | apply | destroy | refresh | import | output | show | state | taint | untaint)
        ARGS+=("-state=$STATE_DIR_ABS/$PLATFORM.tfstate")
        ;;
    esac
fi

set -x
exec tofu -chdir="$STACK_DIR" "$COMMAND" "${ARGS[@]}" "$@"
